# .env.example — le variabili del progetto, con valori finti. Si copia in .env e si riempie.
# Il .env non entra nel repository né nell'immagine; questo file sì.

APP_NAME=LipariBank AI
DEBUG=false

# per lo sviluppo con uv run: il Postgres del Giorno 3, `docker compose --profile sviluppo up -d postgres`.
# 127.0.0.1 e non localhost: la porta è pubblicata solo su IPv4, e localhost su Windows prova
# prima ::1, perdendo due secondi a ogni connessione
DATABASE_URL=postgresql+asyncpg://lipari:lipari@127.0.0.1:5433/lipari_ai
# il valore d'esempio non passa: generane uno tuo, e lungo
JWT_SECRET=cambiami-con-python-c-import-secrets-token-urlsafe-48

# vuote, il sistema parte lo stesso: i modelli qui sotto sono di Ollama, in locale, e non chiedono
# chiavi. Servono solo se DEFAULT_MODEL è un modello di OpenAI (gpt-...) o di Anthropic (claude-...)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
MAX_TOKENS_PER_REQUEST=2000
DAILY_BUDGET_EUR=5.00
SOGLIA_APPROVAZIONE_EUR=5000
SOGLIA_DOPPIA_FIRMA_EUR=50000

# per docker compose: il database del compose (gli altri valori hanno un default)
POSTGRES_PASSWORD=lipari
# vuota con uv run: le cache restano nel processo. Il compose la imposta da sé
REDIS_URL=
